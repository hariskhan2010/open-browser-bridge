{
  "manifest_version": 3,
  "name": "Open Browser Bridge",
  "short_name": "OBB",
  "version": "0.2.0",
  "description": "Let any AI agent (Claude Code, Codex, Gemini CLI, Cursor, any MCP client) use your browser in its own tab group.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "nativeMessaging",
    "alarms",
    "downloads",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Open the browser agent side panel"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Browser Bridge",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "ui/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
